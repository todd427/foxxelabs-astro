# Anthropic API Key for content generation
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-api-key-here

# Cloudflare Web Analytics beacon token
# Get from: Cloudflare Dashboard → Web Analytics → Site → Add a site → JS Snippet
# Extract the token value from the data-cf-beacon JSON.
# Set in Cloudflare Pages: Project → Settings → Environment Variables → PUBLIC_CF_BEACON_TOKEN
# Leave blank locally; the beacon tag will not render unless this is set.
PUBLIC_CF_BEACON_TOKEN=
