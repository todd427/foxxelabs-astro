---
// src/components/LLMSpotlight.astro
// Reads committed state - no live fetch. data/spotlight.json is produced by the
// daily cron (scripts/spotlight.js) and committed, same as the news collection.
// Render is therefore a pure function of repo state; HF being up at build time
// is irrelevant.
import spotlight from '../../data/spotlight.json';

const pick = spotlight?.pick ?? null;
const fmt = (n) =>
  n >= 1_000_000 ? `${(n / 1e6).toFixed(1)}M`
  : n >= 1_000   ? `${(n / 1e3).toFixed(1)}K`
  : `${n}`;
---

{pick && (
  <aside class="llm-spotlight">
    <header>
      <span class="eyebrow">Check this out</span>
      <span class="byline">&mdash; Todd</span>
    </header>

    <a class="model" href={pick.url} target="_blank" rel="noopener">
      <span class="author">{pick.author}/</span><span class="name">{pick.name}</span>
    </a>

    <p class="blurb">{pick.blurb}</p>

    <footer>
      <span class="stat">&#9829; {fmt(pick.likes)}</span>
      <span class="stat">&darr; {fmt(pick.downloads)}</span>
      {pick.ageDays != null && pick.ageDays < 14 && (
        <span class="stat fresh">{pick.ageDays < 1 ? 'new today' : `${pick.ageDays}d old`}</span>
      )}
      <a class="numbers" href="https://llm-stats.com" target="_blank" rel="noopener">
        benchmarks &rarr; llm-stats
      </a>
    </footer>
  </aside>
)}

<style>
  .llm-spotlight {
    border: 1px solid var(--border, #2a2f37);
    border-radius: var(--radius, 10px);
    padding: 1rem 1.25rem;
    background: var(--surface, #161a20);
    max-width: 34rem;
    font-family: var(--font-body, ui-sans-serif, system-ui);
  }
  header { display: flex; align-items: baseline; gap: .5rem; margin-bottom: .5rem; }
  .eyebrow { font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; color: var(--accent, #d4a017); font-weight: 600; }
  .byline { font-size: .75rem; color: var(--muted, #8b95a1); }
  .model { display: block; font-size: 1.15rem; text-decoration: none; margin-bottom: .4rem; }
  .model:hover .name { text-decoration: underline; }
  .author { color: var(--muted, #8b95a1); }
  .name { color: var(--text, #e8edf2); font-weight: 600; }
  .blurb { margin: 0 0 .75rem; line-height: 1.5; color: var(--text, #cdd4dc); font-size: .92rem; }
  footer { display: flex; align-items: center; gap: .9rem; font-size: .78rem; color: var(--muted, #8b95a1); }
  .stat.fresh { color: var(--accent, #d4a017); }
  .numbers { margin-left: auto; color: var(--muted, #8b95a1); text-decoration: none; }
  .numbers:hover { color: var(--text, #e8edf2); text-decoration: underline; }
</style>
