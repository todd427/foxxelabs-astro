---
// src/components/LLMSpotlight.astro
// Reads committed state - no live fetch. data/spotlight.json is produced by the
// daily cron (scripts/spotlight.js) and committed, same as the news collection.
// Render is therefore a pure function of repo state; HF being up at build time
// is irrelevant. Renders nothing when pick is null (page handles empty state).
import spotlight from '../../data/spotlight.json';

const pick = spotlight?.pick ?? null;
const fmt = (n: number) =>
  n >= 1_000_000 ? `${(n / 1e6).toFixed(1)}M`
  : n >= 1_000   ? `${(n / 1e3).toFixed(1)}K`
  : `${n}`;
---

{pick && (
  <aside class="llm-spotlight card">
    <header class="ls-head">
      <span class="ls-eyebrow">Check this out</span>
      <span class="ls-byline">&mdash; Todd</span>
    </header>

    <a class="ls-model" href={pick.url} target="_blank" rel="noopener">
      <span class="ls-author">{pick.author}/</span><span class="ls-name">{pick.name}</span>
    </a>

    <p class="ls-blurb">{pick.blurb}</p>

    <footer class="ls-foot">
      <span class="ls-stat">&#9829; {fmt(pick.likes)}</span>
      <span class="ls-stat">&darr; {fmt(pick.downloads)}</span>
      {pick.ageDays != null && pick.ageDays < 14 && (
        <span class="ls-stat ls-fresh">{pick.ageDays < 1 ? 'new today' : `${pick.ageDays}d old`}</span>
      )}
      <a class="ls-numbers" href="https://llm-stats.com" target="_blank" rel="noopener">benchmarks &rarr; llm-stats</a>
    </footer>
  </aside>
)}

<style>
  /* Uses the site's global tokens so it adapts across dark/light/editorial. */
  .llm-spotlight { max-width: 36rem; }
  .ls-head { display: flex; align-items: baseline; gap: .5rem; margin-bottom: .5rem; }
  .ls-eyebrow {
    font-size: .72rem; letter-spacing: .12em; text-transform: uppercase;
    color: var(--accent); font-weight: 700;
  }
  .ls-byline { font-size: .78rem; color: var(--muted); }
  .ls-model { display: block; font-size: 1.2rem; text-decoration: none; margin-bottom: .45rem; }
  .ls-model:hover .ls-name { text-decoration: underline; }
  .ls-author { color: var(--muted); }
  .ls-name { color: var(--text); font-weight: 700; }
  .ls-blurb { margin: 0 0 .9rem; line-height: 1.6; color: var(--text); font-size: .98rem; }
  .ls-foot { display: flex; align-items: center; gap: 1rem; font-size: .82rem; color: var(--muted); }
  .ls-fresh { color: var(--accent); font-weight: 600; }
  .ls-numbers { margin-left: auto; color: var(--muted); text-decoration: none; }
  .ls-numbers:hover { color: var(--text); text-decoration: underline; }
</style>
