---
interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const { 
  title, 
  description = 'FoxxeLabs — an Irish AI research lab. Working cognitive architecture in production: Mnemos at 75,000+ documents, Léargas, Aislinge, and 12+ services on Fly.io. MSc cyberpsychology research.',
  image = '/og-default.png',
  type = 'website'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;

// Cloudflare Web Analytics — env-gated. Set PUBLIC_CF_BEACON_TOKEN in
// Cloudflare Pages env vars to activate. No-op until then.
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="canonical" href={canonicalURL} />
  
  <!-- Primary Meta Tags -->
  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={description} />
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.site)} />
  
  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={canonicalURL} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content={new URL(image, Astro.site)} />

  <!-- Editorial theme fonts (loaded for all themes; only applied when [data-theme="editorial"]) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,600;1,8..60,300;1,8..60,400&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />

  <!-- Theme: apply before paint to prevent flash -->
  <script is:inline>
    (function() {
      const stored = localStorage.getItem('foxxe-theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const validThemes = ['dark', 'light', 'editorial'];
      let resolved;
      if (validThemes.includes(stored)) {
        resolved = stored;
      } else {
        resolved = prefersDark ? 'dark' : 'light';
      }
      document.documentElement.setAttribute('data-theme', resolved);
    })();
  </script>

  {cfBeaconToken && (
    <script
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={`{"token": "${cfBeaconToken}"}`}
    ></script>
  )}
</head>
<body>
  <div class="sitebar">
    <div class="sitebar-inner">
      <a class="brand" href="/">Foxxe Labs</a>
      <nav class="nav">
        <a class={currentPath === '/' ? 'active' : ''} href="/">Home</a>
        <a class={currentPath.startsWith('/anseo-ui') ? 'active' : ''} href="/anseo-ui/index.html">Anseo UI Dev</a>
        <a class={currentPath.startsWith('/resources') ? 'active' : ''} href="/resources/">Resources</a>
        <a class={currentPath.startsWith('/news') ? 'active' : ''} href="/news/">News</a>
        <a class={currentPath.startsWith('/things-to-watch') ? 'active' : ''} href="/things-to-watch/">Things to Watch</a>
        <a class={currentPath.startsWith('/tools') ? 'active' : ''} href="/tools/">Tools</a>
        <a class={currentPath.startsWith('/about') ? 'active' : ''} href="/about/">About</a>
        <a class={currentPath.startsWith('/contact') ? 'active' : ''} href="/contact/">Contact</a>
        <button id="theme-toggle" class="theme-btn" aria-label="Toggle theme" title="Toggle theme">
          <span class="theme-icon"></span>
        </button>
      </nav>
    </div>
  </div>

  <main>
    <slot />
  </main>

  <footer>
    <div>&copy; {new Date().getFullYear()} Foxxe Labs · Donegal, Ireland. Cognitive architecture, in production.</div>
  </footer>

  <script is:inline>
    (function() {
      const btn = document.getElementById('theme-toggle');
      const icon = btn.querySelector('.theme-icon');
      const mq = window.matchMedia('(prefers-color-scheme: dark)');

      // dark → light → editorial → system → dark
      const ICONS  = { dark: '☽', light: '☀', editorial: 'ƒ', system: '⊙' };
      const CYCLE  = { dark: 'light', light: 'editorial', editorial: 'system', system: 'dark' };
      const LABELS = { dark: 'Dark', light: 'Light', editorial: 'Editorial', system: 'System' };

      function getStored() {
        return localStorage.getItem('foxxe-theme') || 'system';
      }

      function applyTheme(mode) {
        let resolved;
        if (mode === 'system') {
          resolved = mq.matches ? 'dark' : 'light';
        } else {
          resolved = mode;
        }
        document.documentElement.setAttribute('data-theme', resolved);
        btn.title = 'Theme: ' + LABELS[mode];
        icon.textContent = ICONS[mode];
      }

      function cycleTheme() {
        const current = getStored();
        const next = CYCLE[current] || 'dark';
        if (next === 'system') {
          localStorage.removeItem('foxxe-theme');
        } else {
          localStorage.setItem('foxxe-theme', next);
        }
        applyTheme(next);
      }

      applyTheme(getStored());
      btn.addEventListener('click', cycleTheme);

      mq.addEventListener('change', function() {
        if (getStored() === 'system') applyTheme('system');
      });
    })();
  </script>
</body>
</html>

<style is:global>
  /* ─────────────────────────────────────────────────────────────────────────
     Design tokens — dark theme (default)
     ───────────────────────────────────────────────────────────────────────── */
  :root, [data-theme="dark"] {
    --bg:    #0b0f14;
    --card:  #121923;
    --muted: #9fb0c3;
    --text:  #e9f0f7;
    --accent:  #7dd3fc;
    --accent2: #a78bfa;
    --border:  rgba(255,255,255,.10);
    --sitebar-bg: rgba(11,15,20,.72);
    --body-gradient:
      radial-gradient(1200px 800px at 15% 10%, rgba(167,139,250,.18), transparent 55%),
      radial-gradient(1000px 700px at 85% 20%, rgba(125,211,252,.16), transparent 55%),
      var(--bg);

    --color-bg:              var(--bg);
    --color-text:            var(--text);
    --color-text-muted:      var(--muted);
    --color-accent:          var(--accent);
    --color-accent-bright:   #b3e7ff;
    --color-accent-dim:      rgba(125,211,252,.25);
    --color-surface:         var(--card);
    --color-surface-elevated:#1a2535;
    --color-border:          var(--border);

    --font-body:    system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
    --font-display: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
    --font-mono:    ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, monospace;
    --content-max:  720px;

    --space-xs: 4px; --space-sm: 8px; --space-md: 14px;
    --space-lg: 20px; --space-xl: 32px; --space-2xl: 48px; --space-3xl: 72px;
  }

  /* ─────────────────────────────────────────────────────────────────────────
     Light theme
     ───────────────────────────────────────────────────────────────────────── */
  [data-theme="light"] {
    --bg:    #f4f6f9;
    --card:  #ffffff;
    --muted: #5a6a7a;
    --text:  #111820;
    --accent:  #0369a1;
    --accent2: #6d28d9;
    --border:  rgba(0,0,0,.09);
    --sitebar-bg: rgba(244,246,249,.85);
    --body-gradient:
      radial-gradient(1200px 800px at 15% 10%, rgba(109,40,217,.06), transparent 55%),
      radial-gradient(1000px 700px at 85% 20%, rgba(3,105,161,.07), transparent 55%),
      var(--bg);

    --color-bg:              var(--bg);
    --color-text:            var(--text);
    --color-text-muted:      var(--muted);
    --color-accent:          var(--accent);
    --color-accent-bright:   #0284c7;
    --color-accent-dim:      rgba(3,105,161,.2);
    --color-surface:         var(--card);
    --color-surface-elevated:#f0f2f5;
    --color-border:          var(--border);

    --font-body:    system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
    --font-display: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
    --font-mono:    ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, monospace;
  }

  /* ─────────────────────────────────────────────────────────────────────────
     Editorial theme — paper, ink, Playfair Display, Source Serif 4
     ───────────────────────────────────────────────────────────────────────── */
  [data-theme="editorial"] {
    --bg:    #f5f0e8;
    --card:  #ede8de;
    --muted: #6b6560;
    --text:  #1a1814;
    --accent:  #c0392b;
    --accent2: #b8860b;
    --border:  rgba(26,24,20,.12);
    --sitebar-bg: rgba(245,240,232,.90);
    --body-gradient: var(--bg);

    --color-bg:              var(--bg);
    --color-text:            var(--text);
    --color-text-muted:      var(--muted);
    --color-accent:          var(--accent);
    --color-accent-bright:   #922b21;
    --color-accent-dim:      rgba(192,57,43,.15);
    --color-surface:         var(--card);
    --color-surface-elevated:#e8e2d6;
    --color-border:          var(--border);

    --font-body:    'Source Serif 4', Georgia, serif;
    --font-display: 'Playfair Display', Georgia, serif;
    --font-mono:    'JetBrains Mono', ui-monospace, Menlo, monospace;
  }

  /* Editorial-specific overrides */
  [data-theme="editorial"] body {
    font-family: var(--font-body);
    font-weight: 300;
    line-height: 1.75;
  }

  [data-theme="editorial"] h1,
  [data-theme="editorial"] h2,
  [data-theme="editorial"] h3,
  [data-theme="editorial"] h4 {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  [data-theme="editorial"] .brand {
    font-family: var(--font-display);
    font-weight: 900;
    font-style: italic;
    letter-spacing: 0;
  }

  [data-theme="editorial"] code,
  [data-theme="editorial"] pre,
  [data-theme="editorial"] .font-mono {
    font-family: var(--font-mono);
  }

  [data-theme="editorial"] .card {
    border-color: rgba(26,24,20,.12);
    background: rgba(237,232,222,.92);
    box-shadow: 2px 2px 0 rgba(26,24,20,.06);
  }

  [data-theme="editorial"] .sitebar {
    border-bottom: 2px solid rgba(26,24,20,.15);
  }

  [data-theme="editorial"] footer {
    border-top: 1px solid rgba(26,24,20,.12);
  }

  /* ─────────────────────────────────────────────────────────────────────────
     Base reset + global styles
     ───────────────────────────────────────────────────────────────────────── */
  * { box-sizing: border-box; }

  body {
    margin: 0;
    font-family: var(--font-body, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif);
    background: var(--body-gradient);
    color: var(--text);
    line-height: 1.45;
    transition: background 0.2s, color 0.2s;
  }

  a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent);
    text-underline-offset: 2px;
  }
  a:hover {
    color: var(--color-accent-bright);
    text-decoration-color: var(--color-accent-bright);
  }

  /* ── Nav bar ── */
  .sitebar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--sitebar-bg);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(10px);
    transition: background 0.2s, border-color 0.2s;
  }

  .sitebar-inner {
    max-width: 980px;
    margin: 0 auto;
    padding: 12px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  .brand {
    font-weight: 900;
    letter-spacing: .2px;
    text-decoration: none;
    color: var(--text);
  }

  .nav {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
  }

  .nav a {
    color: var(--muted);
    text-decoration: none;
    font-weight: 750;
    padding: 6px 10px;
    border-radius: 999px;
    border: 1px solid transparent;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .nav a:hover {
    color: var(--text);
    border-color: color-mix(in srgb, var(--text) 12%, transparent);
  }
  .nav a.active {
    color: var(--text);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .theme-btn {
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    cursor: pointer;
    font-size: 14px;
    line-height: 1;
    padding: 6px 10px;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .theme-btn:hover {
    color: var(--text);
    border-color: color-mix(in srgb, var(--text) 20%, transparent);
    background: color-mix(in srgb, var(--text) 5%, transparent);
  }

  /* ── Layout ── */
  main {
    max-width: 980px;
    margin: 0 auto;
    padding: 28px 18px 70px;
  }

  .card {
    background: color-mix(in srgb, var(--card) 92%, transparent);
    border: 1px solid var(--border);
    border-radius: 22px;
    padding: 18px;
    box-shadow: 0 18px 40px rgba(0,0,0,.18);
    backdrop-filter: blur(6px);
  }

  h1 { margin: 0 0 10px 0; font-size: clamp(1.7rem, 3.2vw, 2.6rem); letter-spacing: .2px; }
  h2 { margin: 0 0 10px 0; font-size: 1.2rem; }
  h3 { margin: 0 0 8px 0;  font-size: 1.1rem; }
  h4 { margin: 0 0 8px 0;  font-size: 1rem; }

  .muted { color: var(--muted); }

  footer {
    max-width: 980px;
    margin: 0 auto;
    padding: 0 18px 40px;
    color: var(--muted);
    font-size: .92rem;
  }

  @media (max-width: 768px) {
    .sitebar-inner { flex-direction: column; align-items: stretch; }
    .nav { justify-content: center; }
  }
</style>
