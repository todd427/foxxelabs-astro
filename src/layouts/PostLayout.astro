---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'resources'> | CollectionEntry<'news'>;
}

const { entry } = Astro.props;
const { title, description, publishDate, updatedDate, category, tags, heroImage, heroImageAlt } = entry.data;
const { Content } = await entry.render();

const formattedDate = publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const formattedUpdatedDate = updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<BaseLayout title={`${title} | Foxxe Labs`} description={description} image={heroImage} type="article">
  <article class="post">
    <div class="post-header">
      <div class="container-narrow">
        <div class="post-meta">
          <span class="post-category">{category}</span>
          <span class="post-divider">•</span>
          <time datetime={publishDate.toISOString()}>{formattedDate}</time>
          {updatedDate && (
            <>
              <span class="post-divider">•</span>
              <span class="post-updated">Updated {formattedUpdatedDate}</span>
            </>
          )}
        </div>
        
        <h1 class="post-title">{title}</h1>
        <p class="post-description">{description}</p>
        
        <div class="post-tags">
          {tags.map(tag => (
            <a href={`/resources/tags/${tag.toLowerCase().replace(/\s+/g, '-')}/`} class="tag">
              #{tag}
            </a>
          ))}
        </div>
      </div>
    </div>
    
    {heroImage && (
      <div class="post-hero">
        <img src={heroImage} alt={heroImageAlt || title} />
      </div>
    )}
    
    <div class="post-content">
      <div class="container-narrow">
        <Content />
      </div>
    </div>
    
    {'furtherReading' in entry.data && entry.data.furtherReading && entry.data.furtherReading.length > 0 && (
      <div class="post-further-reading">
        <div class="container-narrow">
          <h2>Further Reading</h2>
          <ul class="further-reading-list">
            {entry.data.furtherReading.map((item: any) => (
              <li>
                <a href={item.url} target="_blank" rel="noopener noreferrer">
                  {item.title}
                </a>
                {item.source && <span class="source">— {item.source}</span>}
              </li>
            ))}
          </ul>
        </div>
      </div>
    )}
  </article>
</BaseLayout>

<style>
  .container-narrow {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* ── Post header ── */
  .post-header {
    margin-bottom: 48px;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: ui-monospace, 'Cascadia Code', Menlo, Consolas, monospace;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    margin-bottom: 20px;
  }

  .post-category {
    color: var(--accent);
    font-weight: 600;
  }

  .post-divider {
    opacity: 0.3;
  }

  .post-updated {
    font-style: italic;
  }

  .post-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 20px;
    letter-spacing: -0.02em;
  }

  .post-description {
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--muted);
    margin-bottom: 20px;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag {
    display: inline-block;
    padding: 4px 14px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 4px;
    font-family: ui-monospace, Menlo, Consolas, monospace;
    font-size: 0.75rem;
    color: var(--muted);
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
  }

  .tag:hover {
    border-color: var(--accent);
    color: var(--accent);
    text-decoration: none;
  }

  /* ── Hero image ── */
  .post-hero {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto 64px;
    overflow: hidden;
    border-radius: 8px;
  }

  .post-hero img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  /* ── Post content ── */
  .post-content {
    margin-bottom: 64px;
  }

  /* Section headings — gap above, accent left border, gap after bar */
  .post-content :global(h2) {
    margin-top: 64px;
    margin-bottom: 20px;
    font-size: 2rem;
    border-left: 4px solid var(--accent);
    padding-left: 16px;
    line-height: 1.2;
  }

  .post-content :global(h3) {
    margin-top: 40px;
    margin-bottom: 14px;
    font-size: 1.4rem;
    color: var(--accent);
  }

  .post-content :global(h4) {
    margin-top: 28px;
    margin-bottom: 12px;
    font-size: 1.1rem;
  }

  .post-content :global(p) {
    margin-bottom: 20px;
    line-height: 1.8;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: 20px;
    padding-left: 28px;
  }

  .post-content :global(li) {
    margin-bottom: 8px;
    line-height: 1.7;
  }

  .post-content :global(blockquote) {
    margin: 40px 0;
    padding: 20px 24px;
    background: var(--card);
    border-left: 4px solid var(--accent);
    font-style: italic;
    color: var(--muted);
    border-radius: 0 8px 8px 0;
  }

  .post-content :global(code) {
    font-family: ui-monospace, 'Cascadia Code', Menlo, Consolas, monospace;
    font-size: 0.88em;
    background: var(--card);
    padding: 0.2em 0.4em;
    border-radius: 3px;
    color: var(--color-accent-bright);
  }

  .post-content :global(pre) {
    margin: 28px 0;
    padding: 20px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow-x: auto;
  }

  .post-content :global(pre code) {
    background: none;
    padding: 0;
    color: var(--text);
    font-size: 0.9em;
  }

  .post-content :global(img) {
    width: 100%;
    height: auto;
    margin: 32px 0;
    border-radius: 8px;
  }

  .post-content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 35%, transparent);
    text-underline-offset: 2px;
    transition: color 0.2s;
  }

  .post-content :global(a:hover) {
    color: var(--color-accent-bright);
    text-decoration-color: var(--color-accent-bright);
  }

  /* Tables */
  .post-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 28px 0;
    font-size: 0.95rem;
  }

  .post-content :global(th) {
    text-align: left;
    padding: 10px 14px;
    border-bottom: 2px solid var(--border);
    color: var(--muted);
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .post-content :global(td) {
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    line-height: 1.5;
  }

  .post-content :global(tr:last-child td) {
    border-bottom: none;
  }

  /* Horizontal rule as section divider */
  .post-content :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 48px 0;
  }

  /* ── Further reading ── */
  .post-further-reading {
    padding: 48px 0 32px;
    border-top: 1px solid var(--border);
  }

  .post-further-reading h2 {
    font-size: 1.4rem;
    margin-bottom: 20px;
    color: var(--accent);
  }

  .further-reading-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .further-reading-list li {
    margin-bottom: 12px;
    padding-left: 24px;
    position: relative;
    line-height: 1.5;
  }

  .further-reading-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .further-reading-list a {
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    transition: color 0.2s, border-color 0.2s;
  }

  .further-reading-list a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .further-reading-list .source {
    font-family: ui-monospace, Menlo, Consolas, monospace;
    font-size: 0.82rem;
    color: var(--muted);
    margin-left: 6px;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .post-title {
      font-size: 2rem;
    }

    .post-description {
      font-size: 1.05rem;
    }

    .post-content :global(h2) {
      font-size: 1.5rem;
      margin-top: 48px;
    }
  }
</style>
