---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'resources'> | CollectionEntry<'news'>;
}

const { entry } = Astro.props;
const { title, description, publishDate, updatedDate, category, tags, heroImage, heroImageAlt } = entry.data;
const { Content } = await entry.render();

const formattedDate = publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const formattedUpdatedDate = updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<BaseLayout title={`${title} | Foxxe Labs`} description={description} image={heroImage} type="article">
  <article class="post">
    <div class="post-header">
      <div class="container-narrow">
        <div class="post-meta">
          <span class="post-category">{category}</span>
          <span class="post-divider">•</span>
          <time datetime={publishDate.toISOString()}>{formattedDate}</time>
          {updatedDate && (
            <>
              <span class="post-divider">•</span>
              <span class="post-updated">Updated {formattedUpdatedDate}</span>
            </>
          )}
        </div>
        
        <h1 class="post-title">{title}</h1>
        <p class="post-description">{description}</p>
        
        <div class="post-tags">
          {tags.map(tag => (
            <a href={`/resources/tags/${tag.toLowerCase().replace(/\s+/g, '-')}/`} class="tag">
              #{tag}
            </a>
          ))}
        </div>
      </div>
    </div>
    
    {heroImage && (
      <div class="post-hero">
        <img src={heroImage} alt={heroImageAlt || title} />
      </div>
    )}
    
    <div class="post-content">
      <div class="container-narrow">
        <Content />
      </div>
    </div>
    
    {'furtherReading' in entry.data && entry.data.furtherReading && entry.data.furtherReading.length > 0 && (
      <div class="post-further-reading">
        <div class="container-narrow">
          <h2>Further Reading</h2>
          <ul class="further-reading-list">
            {entry.data.furtherReading.map((item: any) => (
              <li>
                <a href={item.url} target="_blank" rel="noopener noreferrer">
                  {item.title}
                </a>
                {item.source && <span class="source">— {item.source}</span>}
              </li>
            ))}
          </ul>
        </div>
      </div>
    )}
  </article>
</BaseLayout>

<style>
  .container-narrow {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--space-lg);
  }
  
  .post-header {
    margin-bottom: var(--space-2xl);
  }
  
  .post-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-lg);
  }
  
  .post-category {
    color: var(--color-accent);
    font-weight: 500;
  }
  
  .post-divider {
    opacity: 0.3;
  }
  
  .post-updated {
    font-style: italic;
  }
  
  .post-title {
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: var(--space-lg);
    letter-spacing: -0.02em;
  }
  
  .post-description {
    font-size: 1.35rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin-bottom: var(--space-lg);
  }
  
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  
  .tag {
    display: inline-block;
    padding: var(--space-xs) var(--space-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: all 0.3s ease;
  }
  
  .tag:hover {
    background: var(--color-surface-elevated);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  
  .post-hero {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto var(--space-3xl);
    overflow: hidden;
    border-radius: 8px;
  }
  
  .post-hero img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }
  
  .post-content {
    margin-bottom: var(--space-3xl);
  }
  
  /* Content typography */
  .post-content :global(h2) {
    margin-top: var(--space-3xl);
    margin-bottom: var(--space-lg);
    font-size: 2rem;
    border-left: 4px solid var(--color-accent);
    padding-left: var(--space-md);
  }
  
  .post-content :global(h3) {
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-md);
    font-size: 1.5rem;
    color: var(--color-accent);
  }
  
  .post-content :global(h4) {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-md);
    font-size: 1.25rem;
  }
  
  .post-content :global(p) {
    margin-bottom: var(--space-lg);
    line-height: 1.8;
  }
  
  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: var(--space-lg);
    padding-left: var(--space-xl);
  }
  
  .post-content :global(li) {
    margin-bottom: var(--space-sm);
    line-height: 1.7;
  }
  
  .post-content :global(blockquote) {
    margin: var(--space-2xl) 0;
    padding: var(--space-lg) var(--space-xl);
    background: var(--color-surface);
    border-left: 4px solid var(--color-accent);
    font-style: italic;
    color: var(--color-text-muted);
  }
  
  .post-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--color-surface);
    padding: 0.2em 0.4em;
    border-radius: 3px;
    color: var(--color-accent-bright);
  }
  
  .post-content :global(pre) {
    margin: var(--space-xl) 0;
    padding: var(--space-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow-x: auto;
  }
  
  .post-content :global(pre code) {
    background: none;
    padding: 0;
    color: var(--color-text);
  }
  
  .post-content :global(img) {
    width: 100%;
    height: auto;
    margin: var(--space-2xl) 0;
    border-radius: 8px;
  }
  
  .post-content :global(a) {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent-dim);
    transition: all 0.3s ease;
  }
  
  .post-content :global(a:hover) {
    color: var(--color-accent-bright);
    border-bottom-color: var(--color-accent-bright);
  }
  
  /* Callout boxes */
  .post-content :global(.callout) {
    margin: var(--space-xl) 0;
    padding: var(--space-lg);
    background: var(--color-surface);
    border-left: 4px solid var(--color-accent);
    border-radius: 4px;
  }
  
  .post-content :global(.callout h4) {
    margin-top: 0;
    margin-bottom: var(--space-sm);
    color: var(--color-accent);
  }
  
  /* Further reading section */
  .post-further-reading {
    padding: var(--space-2xl) 0;
    border-top: 1px solid var(--color-border);
  }
  
  .post-further-reading h2 {
    font-size: 1.75rem;
    margin-bottom: var(--space-lg);
    color: var(--color-accent);
  }
  
  .further-reading-list {
    list-style: none;
    padding: 0;
  }
  
  .further-reading-list li {
    margin-bottom: var(--space-md);
    padding-left: var(--space-lg);
    position: relative;
  }
  
  .further-reading-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }
  
  .further-reading-list a {
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
    transition: all 0.3s ease;
  }
  
  .further-reading-list a:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }
  
  .further-reading-list .source {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-left: var(--space-xs);
  }
  
  /* Responsive */
  @media (max-width: 768px) {
    .post-title {
      font-size: 2.25rem;
    }
    
    .post-description {
      font-size: 1.1rem;
    }
    
    .post-content :global(h2) {
      font-size: 1.5rem;
    }
  }
</style>
