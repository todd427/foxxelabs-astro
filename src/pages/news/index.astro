---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allNews = await getCollection('news', ({ data }) => {
  return data.draft !== true;
});

const sortedNews = allNews.sort((a, b) => 
  b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout title="News | Foxxe Labs" description="Latest developments in AI security, applications, and industry">
  <div class="news-page">
    <div class="page-header">
      <div class="container">
        <h1 class="page-title">News</h1>
        <p class="page-description">
          Curated updates on significant developments in AI — 
          from security incidents to breakthrough research.
        </p>
      </div>
    </div>
    
    <div class="news-list">
      <div class="container">
        {sortedNews.map((post, index) => {
          const formattedDate = post.data.publishDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          });
          
          return (
            <article class="news-item" style={`animation-delay: ${index * 0.08}s`}>
              <div class="news-item-date">
                <time datetime={post.data.publishDate.toISOString()}>{formattedDate}</time>
              </div>
              
              <div class="news-item-content">
                <div class="news-item-meta">
                  <span class="news-item-category">{post.data.category}</span>
                  {post.data.source && (
                    <>
                      <span class="meta-divider">•</span>
                      <span class="news-item-source">{post.data.source}</span>
                    </>
                  )}
                </div>
                
                <h2 class="news-item-title">
                  <a href={`/news/${post.slug}/`}>{post.data.title}</a>
                </h2>
                
                <p class="news-item-description">{post.data.description}</p>
                
                <div class="news-item-tags">
                  {post.data.tags.map(tag => (
                    <span class="mini-tag">#{tag}</span>
                  ))}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .news-page {
    animation: fadeIn 0.6s ease-out;
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .page-header {
    text-align: center;
    margin-bottom: var(--space-3xl);
  }
  
  .page-title {
    font-size: 4rem;
    font-weight: 700;
    margin-bottom: var(--space-lg);
    letter-spacing: -0.03em;
    background: linear-gradient(135deg, var(--color-text) 0%, var(--color-accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  .page-description {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.7;
  }
  
  .news-list {
    max-width: 1000px;
    margin: 0 auto;
  }
  
  .news-item {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: var(--space-xl);
    padding: 2rem 0;
    border-bottom: 1px solid var(--color-border);
    opacity: 0;
    animation: slideUp 0.6s ease-out forwards;
  }
  
  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .news-item:first-child {
    padding-top: 0;
  }
  
  .news-item-date {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    padding-top: 0.5rem;
  }
  
  .news-item-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-md);
  }
  
  .news-item-category {
    color: var(--color-accent);
    font-weight: 500;
  }
  
  .news-item-source {
    color: var(--color-text-muted);
  }
  
  .meta-divider {
    opacity: 0.3;
  }
  
  .news-item-title {
    font-size: 1.75rem;
    margin-bottom: var(--space-md);
    line-height: 1.3;
  }
  
  .news-item-title a {
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.3s ease;
  }
  
  .news-item-title a:hover {
    color: var(--color-accent);
  }
  
  .news-item-description {
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: var(--space-md);
    font-size: 1.05rem;
  }
  
  .news-item-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  
  .mini-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    opacity: 0.7;
  }
  
  @media (max-width: 768px) {
    .page-title {
      font-size: 2.5rem;
    }
    
    .page-description {
      font-size: 1.1rem;
    }
    
    .news-item {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
    
    .news-item-title {
      font-size: 1.35rem;
    }
  }
</style>
