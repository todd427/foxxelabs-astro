---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources', ({ data }) => {
  return data.draft !== true;
});

const news = await getCollection('news', ({ data }) => {
  return data.draft !== true;
});

const latestResources = resources
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const latestNews = news
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 4);
---

<BaseLayout title="Foxxe Labs">

  <!-- Featured Research Banner -->
  <section class="featured-research">
    <div class="featured-label">Featured Research</div>
    <div class="featured-grid">
      <a class="featured-card" href="/ai-bubble/index.html">
        <span class="featured-tag">FoxxeLabs Research</span>
        <h2>Managing the AI Bubble</h2>
        <p>The economics of AI disruption: who captures value, what breaks, and positioning strategies for 2026–2028.</p>
        <span class="featured-link">View presentation →</span>
      </a>
      <a class="featured-card" href="/after-the-bubble/index.html">
        <span class="featured-tag new">FoxxeLabs Research — New</span>
        <h2>After the Bubble: What Comes Next?</h2>
        <p>The labour-for-wages model is breaking. Displacement, the meaning crisis, and cooperative on-ramps for Ireland.</p>
        <span class="featured-link">Read the exploration →</span>
      </a>
      <a class="featured-card" href="/ai-timeline/">
        <span class="featured-tag new">FoxxeLabs Research — New</span>
        <h2>AI Model Performance Timeline</h2>
        <p>Interactive benchmark chart tracking every major ChatGPT and Claude release since 2022. The convergence story, visualised.</p>
        <span class="featured-link">Explore the chart →</span>
      </a>
    </div>
  </section>

  <section class="hero">
    <div class="card">
      <div class="kicker">Knowledge & Analysis</div>
      <h1>AI security, applications, and industry insights</h1>
      <p class="sub">
        In-depth resources and curated news for technical readers navigating the rapidly evolving AI landscape.
        Some posts are comprehensive guides. Some are quick updates. All aim to be useful.
      </p>

      <div class="ctaRow">
        <a class="btn" href="/resources/">Browse Resources</a>
        <a class="btn secondary" href="/news/">Latest News</a>
        <a class="btn secondary" href="/tfi-live.html">Evil IFT (Prototype)</a>
        <a class="btn secondary" href="/cyber-ethics-ip/index.html">Cyber Ethics (IP)</a>
        <a class="btn secondary" href="/esc-quiz/">E-commerce Psychology Quiz</a>
      </div>

      <div class="pillrow">
        <span class="pill">Static site</span>
        <span class="pill">Astro-powered</span>
        <span class="pill">RSS available</span>
        <span class="pill">No tracking by default</span>
      </div>
    </div>

    <div class="card">
      <h2>Latest Resources</h2>
      <ul class="list">
        {latestResources.map(post => (
          <li>
            <a href={`/resources/${post.slug}/`}>{post.data.title}</a>
            <span class="muted"> — {post.data.category}</span>
          </li>
        ))}
      </ul>

      <h2 style="margin-top:16px;">What this is (and isn't)</h2>
      <ul class="list">
        <li><strong>Is:</strong> actionable guides, frameworks, and credible news summaries.</li>
        <li><strong>Isn't:</strong> hot takes, hype, or shallow coverage.</li>
      </ul>
    </div>
  </section>


  <section class="sionnach-section">
    <div class="sionnach-card">
      <div class="sionnach-inner">
        <div class="sionnach-text">
          <div class="sionnach-eyebrow">Foxxe Labs — New Product</div>
          <h2 class="sionnach-title">
            <a href="https://sionnach.ie" target="_blank" rel="noopener noreferrer" class="sionnach-name-link">Sionnach</a>
          </h2>
          <p class="sionnach-tagline">
            A conversation with someone who has been dead for centuries — running entirely on your device.
          </p>
          <p class="sionnach-body">
            <em>Sionnach</em> (the Irish word for fox) is a personality engine built on WebNN and WebGPU —
            modern browser standards that run neural networks directly on your GPU.
            No server. No account. No data leaving your device.
            Choose a historical figure — Turing, Darwin, Darrow, Hugo, Socrates —
            and have the conversation you never could.
          </p>
          <p class="sionnach-privacy">
            This is not just a privacy position. It is a demonstration that meaningful, characterful AI
            does not require enormous centralised compute. It runs on the device in your pocket.
          </p>
          <div class="sionnach-ctas">
            <a class="sionnach-btn primary" href="https://sionnach.ie" target="_blank" rel="noopener noreferrer">
              Visit sionnach.ie →
            </a>
            <a class="sionnach-btn secondary" href="https://sionnach.eu" target="_blank" rel="noopener noreferrer">
              sionnach.eu
            </a>
          </div>
        </div>
        <div class="sionnach-cast">
          <div class="sionnach-cast-label">The Cast</div>
          <div class="sionnach-cast-grid">
            {[
              { name: "Socrates",           role: "Philosopher" },
              { name: "Alan Turing",        role: "Scientist" },
              { name: "Marie Curie",        role: "Scientist" },
              { name: "Charles Darwin",     role: "Scientist" },
              { name: "Victor Hugo",        role: "Writer" },
              { name: "William Shakespeare",role: "Writer" },
              { name: "Julius Caesar",      role: "Statesman" },
              { name: "Winston Churchill",  role: "Statesman" },
              { name: "Clarence Darrow",    role: "Legal Mind" },
              { name: "Aristophanes",       role: "Comedian" },
            ].map(p => (
              <div class="sionnach-person">
                <span class="sionnach-person-name">{p.name}</span>
                <span class="sionnach-person-role">{p.role}</span>
              </div>
            ))}
          </div>
          <div class="sionnach-cast-more">+ more being added · create your own</div>
        </div>
      </div>
    </div>
  </section>

  <section class="video-section">
    <div class="card">
      <h2>What is Cyberpsychology? John Suler's video</h2>
      <div class="video-wrapper">
        <iframe
          src="https://www.youtube.com/embed/4C8qpN0Qafo"
          title="What is Cyberpsychology? — John Suler"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>

      <div class="further-reading">
        <h3>Further Reading</h3>
        <ul class="list">
          <li>
            Kaye, L. K. (n.d.). <em>Building a career in cyberpsychology</em> [Microsoft Sway].
            Edge Hill University.
            <a href="https://sway.cloud.microsoft/2HUh7329A8UDqF2j" target="_blank" rel="noopener noreferrer">
              View presentation →
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="grid2">
    <div class="card">
      <h2>Resources</h2>
      <p class="muted">In-depth guides on AI model types, security patterns, applications, and industry developments.</p>
      <ul class="list">
        <li><a href="/resources/">All resources</a></li>
        {latestResources.slice(0, 2).map(post => (
          <li><a href={`/resources/${post.slug}/`}>{post.data.title}</a></li>
        ))}
      </ul>
    </div>

    <div class="card">
      <h2>News</h2>
      <p class="muted">Curated updates on significant AI developments — model releases, research breakthroughs, and industry shifts.</p>
      <ul class="list">
        <li><a href="/news/">All news</a></li>
        {latestNews.slice(0, 2).map(post => (
          <li>
            <a href={`/news/${post.slug}/`}>{post.data.title}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="grid2">
    <div class="card">
      <h2>Browse by Category</h2>
      <ul class="list">
        <li><a href="/resources/categories/foundations/">Foundations</a></li>
        <li><a href="/resources/categories/security/">Security</a></li>
        <li><a href="/resources/categories/applications/">Applications</a></li>
        <li><a href="/resources/categories/industry/">Industry</a></li>
      </ul>
    </div>

    <div class="card">
      <h2>Contact</h2>
      <p class="muted">
        Get in touch or subscribe to updates.
      </p>
      <ul class="list">
        <li><a href="/contact/">Contact page</a></li>
        <li><a href="/rss.xml">Subscribe to RSS feed</a></li>
        <li class="muted">Email: contact@foxxelabs.ie</li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Featured Research Banner ── */
  .featured-research {
    background: linear-gradient(135deg, rgba(13, 33, 55, 0.9), rgba(19, 39, 68, 0.9));
    border: 1px solid rgba(45, 212, 191, 0.25);
    border-radius: 14px;
    padding: 24px 28px;
    margin-bottom: 18px;
  }

  .featured-label {
    font-size: .85rem;
    text-transform: uppercase;
    letter-spacing: .18em;
    color: #fbbf24;
    font-weight: 800;
    margin-bottom: 16px;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }

  .featured-card {
    display: block;
    text-decoration: none;
    background: rgba(15, 22, 41, 0.6);
    border: 1px solid rgba(45, 212, 191, 0.15);
    border-radius: 10px;
    padding: 22px 24px;
    transition: border-color 0.3s ease, background 0.3s ease;
  }

  .featured-card:hover {
    border-color: rgba(45, 212, 191, 0.45);
    background: rgba(15, 22, 41, 0.85);
  }

  .featured-tag {
    display: inline-block;
    font-size: .72rem;
    text-transform: uppercase;
    letter-spacing: .14em;
    color: #2dd4bf;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .featured-tag.new {
    color: #fbbf24;
  }

  .featured-card h2 {
    font-size: 1.55rem;
    color: #e0e8f0;
    margin: 0 0 8px 0;
    line-height: 1.3;
  }

  .featured-card p {
    font-size: .95rem;
    color: var(--muted);
    line-height: 1.55;
    margin: 0 0 14px 0;
  }

  .featured-link {
    font-size: .92rem;
    color: #2dd4bf;
    font-weight: 700;
  }

  .featured-card:hover .featured-link {
    text-decoration: underline;
  }

  /* ── Existing Styles ── */
  .hero {
    display: grid;
    grid-template-columns: 1.2fr .8fr;
    gap: 18px;
    align-items: stretch;
    margin-bottom: 18px;
  }
  
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }
  }
  
  .hero h1 {
    font-size: 1.65rem;
    line-height: 1.3;
  }

  .kicker {
    font-weight: 900;
    color: #d7e4f2;
    letter-spacing: .2px;
    text-transform: uppercase;
    font-size: .85rem;
    margin-bottom: 10px;
  }
  
  .sub {
    color: var(--muted);
    margin: 0 0 16px 0;
    max-width: 70ch;
  }
  
  .ctaRow {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 10px 12px;
    text-decoration: none;
    font-weight: 850;
    color: var(--text);
    background: linear-gradient(180deg, rgba(125,211,252,.22), rgba(167,139,250,.10));
    transition: border-color 0.3s ease;
  }
  
  .btn.secondary {
    background: rgba(255,255,255,.03);
    font-weight: 700;
    color: var(--muted);
  }
  
  .btn:hover {
    border-color: rgba(255,255,255,.22);
  }
  
  .pillrow {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  
  .pill {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 6px 10px;
    color: var(--muted);
    font-size: .92rem;
    background: rgba(255,255,255,.03);
  }
  
  .video-section {
    margin-bottom: 18px;
  }

  .video-wrapper {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    margin-top: 12px;
    border-radius: 10px;
  }

  .further-reading {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid rgba(255,255,255,.08);
  }

  .further-reading h3 {
    font-size: .85rem;
    text-transform: uppercase;
    letter-spacing: .14em;
    color: #2dd4bf;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .further-reading .list {
    font-size: .93rem;
    color: var(--muted);
    line-height: 1.65;
  }

  .video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 10px;
  }

  .grid2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 16px;
  }
  
  @media (max-width: 900px) {
    .grid2 {
      grid-template-columns: 1fr;
    }
  }
  
  .list {
    margin: 8px 0 0 18px;
    color: #d5e2f0;
    line-height: 1.6;
  }
  
  .list li {
    margin-bottom: 6px;
  }

  /* ── Sionnach Section ── */
  .sionnach-section {
    margin-bottom: 18px;
  }

  .sionnach-card {
    background: linear-gradient(135deg, rgba(20, 14, 30, 0.95), rgba(28, 18, 42, 0.95));
    border: 1px solid rgba(167, 139, 250, 0.30);
    border-radius: 14px;
    padding: 28px;
    box-shadow: 0 18px 40px rgba(0,0,0,.28), 0 0 60px rgba(167,139,250,.06);
  }

  .sionnach-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 32px;
    align-items: start;
  }

  @media (max-width: 760px) {
    .sionnach-inner {
      grid-template-columns: 1fr;
    }
  }

  .sionnach-eyebrow {
    font-size: .78rem;
    text-transform: uppercase;
    letter-spacing: .18em;
    color: #a78bfa;
    font-weight: 700;
    margin-bottom: 10px;
  }

  .sionnach-title {
    font-size: 2rem;
    margin: 0 0 10px;
    line-height: 1.1;
    letter-spacing: .5px;
  }

  .sionnach-name-link {
    color: #e9d5ff;
    text-decoration: none;
    background: linear-gradient(90deg, #a78bfa, #c4b5fd);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .sionnach-name-link:hover {
    opacity: 0.85;
  }

  .sionnach-tagline {
    font-size: 1.05rem;
    color: #c4b5fd;
    margin: 0 0 14px;
    line-height: 1.5;
    font-style: italic;
  }

  .sionnach-body {
    font-size: .95rem;
    color: var(--muted);
    line-height: 1.7;
    margin: 0 0 10px;
    max-width: 58ch;
  }

  .sionnach-privacy {
    font-size: .88rem;
    color: rgba(167,139,250,.7);
    line-height: 1.6;
    margin: 0 0 20px;
    max-width: 58ch;
    border-left: 2px solid rgba(167,139,250,.3);
    padding-left: 12px;
  }

  .sionnach-ctas {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .sionnach-btn {
    display: inline-flex;
    align-items: center;
    border-radius: 14px;
    padding: 10px 16px;
    text-decoration: none;
    font-weight: 700;
    font-size: .95rem;
    transition: border-color 0.2s, opacity 0.2s;
    border: 1px solid transparent;
  }

  .sionnach-btn.primary {
    background: linear-gradient(135deg, rgba(167,139,250,.25), rgba(196,181,253,.15));
    border-color: rgba(167,139,250,.5);
    color: #e9d5ff;
  }

  .sionnach-btn.primary:hover {
    border-color: rgba(167,139,250,.9);
    opacity: 0.9;
  }

  .sionnach-btn.secondary {
    background: rgba(255,255,255,.03);
    border-color: rgba(255,255,255,.1);
    color: var(--muted);
  }

  .sionnach-btn.secondary:hover {
    border-color: rgba(255,255,255,.22);
    color: var(--text);
  }

  .sionnach-cast {
    min-width: 200px;
  }

  .sionnach-cast-label {
    font-size: .75rem;
    text-transform: uppercase;
    letter-spacing: .14em;
    color: rgba(167,139,250,.6);
    font-weight: 700;
    margin-bottom: 10px;
  }

  .sionnach-cast-grid {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .sionnach-person {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .sionnach-person-name {
    font-size: .88rem;
    color: #d8b4fe;
    font-weight: 600;
  }

  .sionnach-person-role {
    font-size: .75rem;
    color: rgba(167,139,250,.5);
    text-transform: uppercase;
    letter-spacing: .1em;
  }

  .sionnach-cast-more {
    margin-top: 10px;
    font-size: .75rem;
    color: rgba(167,139,250,.45);
    font-style: italic;
  }

</style>
