---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources', ({ data }) => {
  return data.draft !== true;
});

const news = await getCollection('news', ({ data }) => {
  return data.draft !== true;
});

const latestResources = resources
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const latestNews = news
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 4);
---

<BaseLayout title="Foxxe Labs">

  <!-- ── LLM Observatory · live globe hero ── -->
  <section class="obs-hero">
    <div class="obs-hero-stage" id="obsHeroStage">
      <iframe id="obsHeroFrame" src="/llm-observatory/view.html" title="The Expanding Universe of Large Language Models — live globe" scrolling="no" tabindex="-1" loading="lazy"></iframe>
    </div>
    <div class="obs-hero-overlay">
      <div class="obs-hero-copy">
        <div class="obs-hero-eyebrow">FoxxeLabs Research · Interactive</div>
        <h2 class="obs-hero-title">The Expanding Universe of LLMs</h2>
        <p class="obs-hero-sub">Watch every landmark model bloom across the globe — 2017 to today, on a live, playable map of the field.</p>
        <span class="obs-hero-btn">Open the live globe →</span>
      </div>
    </div>
    <a class="obs-hero-hit" href="/llm-observatory/view.html" aria-label="Open the LLM Observatory"></a>
  </section>

  <script is:inline>
  (function () {
    var frame = document.getElementById('obsHeroFrame');
    var stage = document.getElementById('obsHeroStage');
    if (!frame || !stage) return;
    function fit() {
      var w = stage.clientWidth, h = stage.clientHeight;
      var s = Math.max(w / 1920, h / 1080);
      frame.style.transform = 'translate(-50%,-50%) scale(' + s + ')';
    }
    window.addEventListener('resize', fit);
    fit();
    frame.addEventListener('load', fit);
  })();
  </script>

  <!-- Featured Research Banner -->
  <section class="featured-research">
    <div class="featured-label">Featured Research</div>
    <div class="featured-grid">
      <a class="featured-card" href="/twenty-watts/">
        <span class="featured-tag new">FoxxeLabs Research — New</span>
        <h2>20W — What It Costs to Train</h2>
        <p>What it really costs to train a mind versus an AI — the energy, the data, the capability — in six charts, and why the obvious comparison misleads in both directions.</p>
        <span class="featured-link">Read the piece →</span>
      </a>
      <a class="featured-card" href="/ai-bubble/index.html">
        <span class="featured-tag">FoxxeLabs Research</span>
        <h2>Managing the AI Bubble</h2>
        <p>The economics of AI disruption: who captures value, what breaks, and positioning strategies for 2026–2028.</p>
        <span class="featured-link">View presentation →</span>
      </a>
      <a class="featured-card" href="/after-the-bubble/index.html">
        <span class="featured-tag new">FoxxeLabs Research — New</span>
        <h2>After the Bubble: What Comes Next?</h2>
        <p>The labour-for-wages model is breaking. Displacement, the meaning crisis, and cooperative on-ramps for Ireland.</p>
        <span class="featured-link">Read the exploration →</span>
      </a>
      <a class="featured-card" href="/ai-timeline/">
        <span class="featured-tag new">FoxxeLabs Research — New</span>
        <h2>AI Model Performance Timeline</h2>
        <p>Interactive benchmark chart tracking every major ChatGPT and Claude release since 2022. The convergence story, visualised.</p>
        <span class="featured-link">Explore the chart →</span>
      </a>
      <a class="featured-card" href="/does-ai-make-us-smarter/">
        <span class="featured-tag new">FoxxeLabs Research — New</span>
        <h2>Does AI Make Us Smarter?</h2>
        <p>A 44× multiplier on one practitioner's project-initiation rate. The augmentation case, the heavy-user cohort, and why the atrophy studies are measuring the wrong thing.</p>
        <span class="featured-link">Read the argument →</span>
      </a>
    </div>
  </section>

  <section class="hero">
    <div class="card">
      <div class="kicker">FoxxeLabs · Donegal, Ireland</div>
      <h1>Cognitive architecture, in production.</h1>
      <p class="sub">
        An Irish research lab. Mnemos at 75,000+ documents, Léargas, Aislinge,
        12+ services on Fly.io. MSc cyberpsychology research.
      </p>

      <div class="ctaRow">
        <a class="btn" href="/resources/">Browse Resources</a>
        <a class="btn secondary" href="/news/">Latest News</a>
        <a class="btn secondary" href="/tools/">The Workshop</a>
        <a class="btn secondary" href="/tfi-live.html">Evil IFT (Prototype)</a>
        <a class="btn secondary" href="/cyber-ethics-ip/index.html">Cyber Ethics (IP)</a>
      </div>

      <div class="pillrow">
        <span class="pill">Static site</span>
        <span class="pill">Astro-powered</span>
        <span class="pill">RSS available</span>
        <span class="pill">No tracking by default</span>
      </div>
    </div>

    <div class="card">
      <h2>Latest Resources</h2>
      <ul class="list">
        {latestResources.map(post => (
          <li>
            <a href={`/resources/${post.slug}/`}>{post.data.title}</a>
            <span class="muted"> — {post.data.category}</span>
          </li>
        ))}
      </ul>

      <h2 style="margin-top:16px;">What this is (and isn't)</h2>
      <ul class="list">
        <li><strong>Is:</strong> actionable guides, frameworks, and credible news summaries.</li>
        <li><strong>Isn't:</strong> hot takes, hype, or shallow coverage.</li>
      </ul>
    </div>
  </section>


  <section class="workshop-section">
    <div class="workshop-card">
      <div class="workshop-inner">
        <div class="workshop-text">
          <div class="workshop-eyebrow">Foxxe Labs — The Workshop</div>
          <h2 class="workshop-title">
            <a href="/tools/" class="workshop-name-link">The Workshop</a>
          </h2>
          <p class="workshop-tagline">
            A cabinet of small, sharp tools — most run entirely in your browser.
          </p>
          <p class="workshop-body">
            Irish pronunciation and flashcards, a bridge-bidding trainer, a build-your-machine guide,
            quizzes on cyberpsychology and the psychology of the buy — and, for the brave, on-device AI
            that runs neural networks directly on your GPU via WebGPU. No server. No account.
            No data leaving your device.
          </p>
          <p class="workshop-privacy">
            A standing demonstration that meaningful, characterful software doesn't require accounts,
            servers, or centralised compute. Most of it runs on the device in front of you.
          </p>
          <div class="workshop-ctas">
            <a class="workshop-btn primary" href="/tools/">Explore the Workshop →</a>
          </div>
        </div>
        <div class="workshop-cast">
          <div class="workshop-cast-label">Headliners</div>
          <div class="workshop-cast-grid">
            {[
              { name: "Sionnach",             role: "On-device AI" },
              { name: "Agora",                role: "On-device debate" },
              { name: "Gaeltacht",            role: "Irish pronunciation" },
              { name: "Foghlaim",             role: "Irish flashcards" },
              { name: "SLAM Bridge",          role: "Bridge trainer" },
              { name: "The Forge",            role: "PC builder" },
              { name: "Cyberpsychology Quiz", role: "Quiz" },
              { name: "aithint",              role: "AI literacy" },
            ].map(p => (
              <div class="workshop-person">
                <span class="workshop-person-name">{p.name}</span>
                <span class="workshop-person-role">{p.role}</span>
              </div>
            ))}
          </div>
          <div class="workshop-cast-more">+ more inside · see them all →</div>
        </div>
      </div>
    </div>
  </section>

  <section class="video-section">
    <div class="card">
      <h2>What is Cyberpsychology? John Suler's video</h2>
      <div class="video-wrapper">
        <iframe
          src="https://www.youtube.com/embed/4C8qpN0Qafo"
          title="What is Cyberpsychology? — John Suler"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>

      <div class="further-reading">
        <h3>Further Reading</h3>
        <ul class="list">
          <li>
            Kaye, L. K. (n.d.). <em>Building a career in cyberpsychology</em> [Microsoft Sway].
            Edge Hill University.
            <a href="https://sway.cloud.microsoft/2HUh7329A8UDqF2j" target="_blank" rel="noopener noreferrer">
              View presentation →
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="grid2">
    <div class="card">
      <h2>Resources</h2>
      <p class="muted">In-depth guides on AI model types, security patterns, applications, and industry developments.</p>
      <ul class="list">
        <li><a href="/resources/">All resources</a></li>
        {latestResources.slice(0, 2).map(post => (
          <li><a href={`/resources/${post.slug}/`}>{post.data.title}</a></li>
        ))}
      </ul>
    </div>

    <div class="card">
      <h2>News</h2>
      <p class="muted">Curated updates on significant AI developments — model releases, research breakthroughs, and industry shifts.</p>
      <ul class="list">
        <li><a href="/news/">All news</a></li>
        {latestNews.slice(0, 2).map(post => (
          <li>
            <a href={`/news/${post.slug}/`}>{post.data.title}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="grid2">
    <div class="card">
      <h2>Browse by Category</h2>
      <ul class="list">
        <li><a href="/resources/categories/foundations/">Foundations</a></li>
        <li><a href="/resources/categories/security/">Security</a></li>
        <li><a href="/resources/categories/applications/">Applications</a></li>
        <li><a href="/resources/categories/industry/">Industry</a></li>
      </ul>
    </div>

    <div class="card">
      <h2>Contact</h2>
      <p class="muted">
        Get in touch or subscribe to updates.
      </p>
      <ul class="list">
        <li><a href="/contact/">Contact page</a></li>
        <li><a href="/rss.xml">Subscribe to RSS feed</a></li>
        <li class="muted">Email: contact@foxxelabs.ie</li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── LLM Observatory · live globe hero ── */
  .obs-hero {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: #070c18;
    height: clamp(300px, 40vw, 520px);
    margin-bottom: 18px;
    box-shadow: 0 18px 50px rgba(0,0,0,.35), 0 0 70px rgba(91,140,255,.05);
  }
  .obs-hero-stage { position: absolute; inset: 0; overflow: hidden; }
  #obsHeroFrame {
    position: absolute;
    left: 50%; top: 50%;
    width: 1920px; height: 1080px;
    border: 0;
    transform-origin: center;
    pointer-events: none;
  }
  .obs-hero-overlay {
    position: absolute; inset: 0;
    pointer-events: none;
    display: flex; align-items: center;
    background:
      linear-gradient(to right, rgba(3,5,12,.9) 0%, rgba(3,5,12,.45) 44%, rgba(3,5,12,0) 72%),
      linear-gradient(to top, rgba(3,5,12,.5), transparent 48%);
  }
  .obs-hero-copy { padding: 0 clamp(24px, 5vw, 56px); max-width: 560px; }
  .obs-hero-eyebrow {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: .72rem; letter-spacing: .18em; text-transform: uppercase;
    color: #7aa2ff; font-weight: 700; margin-bottom: 12px;
  }
  .obs-hero-title {
    font-size: clamp(1.7rem, 3.4vw, 2.6rem);
    line-height: 1.05; margin: 0 0 12px;
    color: #eef2fb; letter-spacing: -.01em;
  }
  .obs-hero-sub {
    font-size: 1rem; line-height: 1.55;
    color: #aab6d4; margin: 0 0 20px; max-width: 42ch;
  }
  .obs-hero-btn {
    display: inline-block;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: .78rem; letter-spacing: .1em; text-transform: uppercase;
    color: #bfe6f5;
    border: 1px solid rgba(120,205,240,.5);
    background: rgba(120,205,240,.12);
    border-radius: 10px; padding: 11px 18px;
    transition: background .25s ease, border-color .25s ease;
  }
  .obs-hero-hit { position: absolute; inset: 0; z-index: 3; }
  .obs-hero:hover .obs-hero-btn { background: rgba(120,205,240,.2); border-color: rgba(120,205,240,.85); }

  /* ── Featured Research Banner ── */
  .featured-research {
    background: color-mix(in srgb, var(--card) 80%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
    border-radius: 14px;
    padding: 24px 28px;
    margin-bottom: 18px;
  }

  .featured-label {
    font-size: .85rem;
    text-transform: uppercase;
    letter-spacing: .18em;
    color: var(--accent2);
    font-weight: 800;
    margin-bottom: 16px;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }

  .featured-card {
    display: block;
    text-decoration: none;
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 22px 24px;
    transition: border-color 0.3s ease, background 0.3s ease;
  }

  .featured-card:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    background: color-mix(in srgb, var(--bg) 90%, transparent);
  }

  .featured-tag {
    display: inline-block;
    font-size: .72rem;
    text-transform: uppercase;
    letter-spacing: .14em;
    color: var(--accent);
    font-weight: 700;
    margin-bottom: 8px;
  }

  .featured-tag.new {
    color: var(--accent2);
  }

  .featured-card h2 {
    font-size: 1.55rem;
    color: var(--text);
    margin: 0 0 8px 0;
    line-height: 1.3;
  }

  .featured-card p {
    font-size: .95rem;
    color: var(--muted);
    line-height: 1.55;
    margin: 0 0 14px 0;
  }

  .featured-link {
    font-size: .92rem;
    color: var(--accent);
    font-weight: 700;
  }

  .featured-card:hover .featured-link {
    text-decoration: underline;
  }

  /* ── Existing Styles ── */
  .hero {
    display: grid;
    grid-template-columns: 1.2fr .8fr;
    gap: 18px;
    align-items: stretch;
    margin-bottom: 18px;
  }
  
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }
  }
  
  .hero h1 {
    font-size: 1.65rem;
    line-height: 1.3;
  }

  .kicker {
    font-weight: 900;
    color: var(--muted);
    letter-spacing: .2px;
    text-transform: uppercase;
    font-size: .85rem;
    margin-bottom: 10px;
  }
  
  .sub {
    color: var(--muted);
    margin: 0 0 16px 0;
    max-width: 70ch;
  }
  
  .ctaRow {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 10px 12px;
    text-decoration: none;
    font-weight: 850;
    color: var(--text);
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    transition: border-color 0.3s ease;
  }
  
  .btn.secondary {
    background: rgba(255,255,255,.03);
    font-weight: 700;
    color: var(--muted);
  }
  
  .btn:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }
  
  .pillrow {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  
  .pill {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 6px 10px;
    color: var(--muted);
    font-size: .92rem;
    background: rgba(255,255,255,.03);
  }
  
  .video-section {
    margin-bottom: 18px;
  }

  .video-wrapper {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    margin-top: 12px;
    border-radius: 10px;
  }

  .further-reading {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }

  .further-reading h3 {
    font-size: .85rem;
    text-transform: uppercase;
    letter-spacing: .14em;
    color: var(--accent);
    font-weight: 700;
    margin-bottom: 8px;
  }

  .further-reading .list {
    font-size: .93rem;
    color: var(--muted);
    line-height: 1.65;
  }

  .video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 10px;
  }

  .grid2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 16px;
  }
  
  @media (max-width: 900px) {
    .grid2 {
      grid-template-columns: 1fr;
    }
  }
  
  .list {
    margin: 8px 0 0 18px;
    color: var(--text);
    line-height: 1.6;
  }
  
  .list li {
    margin-bottom: 6px;
  }

  /* ── Workshop Callout ── */
  .workshop-section {
    margin-bottom: 18px;
  }

  .workshop-card {
    background: linear-gradient(135deg, rgba(20, 14, 30, 0.95), rgba(28, 18, 42, 0.95));
    border: 1px solid rgba(167, 139, 250, 0.30);
    border-radius: 14px;
    padding: 28px;
    box-shadow: 0 18px 40px rgba(0,0,0,.28), 0 0 60px rgba(167,139,250,.06);
  }

  .workshop-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 32px;
    align-items: start;
  }

  @media (max-width: 760px) {
    .workshop-inner {
      grid-template-columns: 1fr;
    }
  }

  .workshop-eyebrow {
    font-size: .78rem;
    text-transform: uppercase;
    letter-spacing: .18em;
    color: #a78bfa;
    font-weight: 700;
    margin-bottom: 10px;
  }

  .workshop-title {
    font-size: 2rem;
    margin: 0 0 10px;
    line-height: 1.1;
    letter-spacing: .5px;
  }

  .workshop-name-link {
    color: #e9d5ff;
    text-decoration: none;
    background: linear-gradient(90deg, #a78bfa, #c4b5fd);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .workshop-name-link:hover {
    opacity: 0.85;
  }

  .workshop-tagline {
    font-size: 1.05rem;
    color: #c4b5fd;
    margin: 0 0 14px;
    line-height: 1.5;
    font-style: italic;
  }

  .workshop-body {
    font-size: .95rem;
    color: var(--muted);
    line-height: 1.7;
    margin: 0 0 10px;
    max-width: 58ch;
  }

  .workshop-privacy {
    font-size: .88rem;
    color: rgba(167,139,250,.7);
    line-height: 1.6;
    margin: 0 0 20px;
    max-width: 58ch;
    border-left: 2px solid rgba(167,139,250,.3);
    padding-left: 12px;
  }

  .workshop-ctas {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .workshop-btn {
    display: inline-flex;
    align-items: center;
    border-radius: 14px;
    padding: 10px 16px;
    text-decoration: none;
    font-weight: 700;
    font-size: .95rem;
    transition: border-color 0.2s, opacity 0.2s;
    border: 1px solid transparent;
  }

  .workshop-btn.primary {
    background: linear-gradient(135deg, rgba(167,139,250,.25), rgba(196,181,253,.15));
    border-color: rgba(167,139,250,.5);
    color: #e9d5ff;
  }

  .workshop-btn.primary:hover {
    border-color: rgba(167,139,250,.9);
    opacity: 0.9;
  }

  .workshop-cast {
    min-width: 200px;
  }

  .workshop-cast-label {
    font-size: .75rem;
    text-transform: uppercase;
    letter-spacing: .14em;
    color: rgba(167,139,250,.6);
    font-weight: 700;
    margin-bottom: 10px;
  }

  .workshop-cast-grid {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .workshop-person {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .workshop-person-name {
    font-size: .88rem;
    color: #d8b4fe;
    font-weight: 600;
  }

  .workshop-person-role {
    font-size: .75rem;
    color: rgba(167,139,250,.5);
    text-transform: uppercase;
    letter-spacing: .1em;
  }

  .workshop-cast-more {
    margin-top: 10px;
    font-size: .75rem;
    color: rgba(167,139,250,.45);
    font-style: italic;
  }

</style>
