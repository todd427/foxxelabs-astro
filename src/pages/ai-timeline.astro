---
// src/pages/ai-timeline.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import AITimeline from '../components/AITimeline.jsx';
import { LAST_UPDATED } from '../data/ai-timeline.js';
import { MODELS } from '../data/llm-observatory.js';
---

<BaseLayout
  title="AI Model Performance Timeline | Foxxe Labs"
  description="A comparative benchmark timeline of OpenAI (ChatGPT) and Anthropic (Claude) model releases from 2022 to September 2026 — MMLU through saturation, then the contested frontier: SWE-bench Pro, Terminal-Bench 2.1, OSWorld 2.0, Frontier-Bench, ARC-AGI-3 and GDPval-AA."
>

  <header class="page-header card">
    <div class="eyebrow">Foxxe Labs Research</div>
    <h1>AI Model Performance Timeline</h1>
    <p class="lede">
      Two charts, two stories. The first tracks MMLU — the knowledge benchmark
      that defined 2022–2025 — across every major OpenAI and Anthropic release.
      The headline: Claude entered 2023 thirteen points behind GPT-4 and had
      fully caught up by mid-2024. Neither lab reports MMLU any more, so the
      2026 tail is shaded as estimate. The second chart covers where the
      frontier is actually contested. Both labs shipped in the first week of
      September — Claude Fable 5.1 on the 1st, GPT-6 Astra on the 3rd — and
      neither published a full sweep, so the bars name the model that actually
      produced each figure rather than implying one pairing. The headline is
      ARC-AGI-3: the widest gap on this page has reversed, with Astra claiming
      99.9% on a stateful harness against Opus 5's 30.2%. Read the notes before
      the gaps; several of these numbers are measured under settings that are
      not directly comparable. Hover any data point for model details and
      source notes.
    </p>
    <div class="meta muted">
      <span>Last updated: {LAST_UPDATED}</span>
      <span class="sep">·</span>
      <span>Todd McCaffrey, Foxxe Labs</span>
    </div>
  </header>

  <section class="chart-section">
    <AITimeline client:load />
  </section>

  <a class="globe-cta card" href="/llm-observatory/view/">
    <div class="globe-copy">
      <div class="eyebrow">Interactive · full screen</div>
      <h2>The Expanding Universe of Large Language Models</h2>
      <p>
        An observatory globe that grows the whole model landscape from the 2017
        Transformer to today — a curated {MODELS.length} models plotted on the city of their lab,
        sized by parameters, raised by capability, and coloured by maker, with a
        playable timeline you can scrub to any month. Follows the site theme.
      </p>
    </div>
    <span class="globe-go">Open the globe <span class="arr">→</span></span>
  </a>

  <footer class="page-footer card">
    <p>
      Related research: &nbsp;
      <a href="/llm-observatory/view/">The Expanding Universe of LLMs</a>
      &nbsp;·&nbsp;
      <a href="/ai-bubble/index.html">Managing the AI Bubble</a>
      &nbsp;·&nbsp;
      <a href="/after-the-bubble/index.html">After the Bubble: What Comes Next?</a>
      &nbsp;·&nbsp;
      <a href="/resources/965-billion-and-a-date/">$965 Billion and a Date</a>
    </p>
  </footer>

</BaseLayout>

<style>
  .page-header {
    margin-bottom: 18px;
  }

  .eyebrow {
    font-size: .8rem;
    text-transform: uppercase;
    letter-spacing: .18em;
    color: var(--accent);
    font-weight: 700;
    margin-bottom: 10px;
  }

  .lede {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 72ch;
    margin: 0 0 14px;
  }

  .meta {
    font-size: .85rem;
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
  }

  .sep { opacity: .4; }

  .chart-section {
    border-radius: 22px;
    overflow: hidden;
    margin-bottom: 18px;
    border: 1px solid var(--border);
  }

  /* Featured link to the standalone interactive globe (public/llm-observatory) */
  .globe-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: 18px;
    text-decoration: none;
    color: var(--text);
    transition: transform .25s ease, border-color .25s ease;
  }
  .globe-cta:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
  }
  .globe-copy { flex: 1; min-width: 280px; }
  .globe-copy h2 { margin: 0 0 8px; font-size: 1.3rem; letter-spacing: -.01em; }
  .globe-copy p { margin: 0; color: var(--muted); font-size: .95rem; line-height: 1.6; max-width: 70ch; }
  .globe-go {
    font-family: var(--font-mono);
    font-size: .78rem;
    text-transform: uppercase;
    letter-spacing: .14em;
    color: var(--accent);
    white-space: nowrap;
  }
  .globe-go .arr { display: inline-block; transition: transform .25s ease; }
  .globe-cta:hover .arr { transform: translateX(4px); }

  .page-footer {
    font-size: .95rem;
  }

  .page-footer p {
    margin: 0;
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .globe-cta, .arr { transition: none; }
  }
</style>
