---
// src/pages/ai-timeline.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import AITimeline from '../components/AITimeline.jsx';
---

<BaseLayout
  title="AI Model Performance Timeline | Foxxe Labs"
  description="A comparative benchmark timeline of OpenAI (ChatGPT) and Anthropic (Claude) model releases from 2022 to 2026, tracking MMLU performance scores, key capabilities, and the convergence of frontier AI."
>

  <header class="page-header card">
    <div class="eyebrow">Foxxe Labs Research</div>
    <h1>AI Model Performance Timeline</h1>
    <p class="lede">
      How fast are the frontier labs actually moving? This chart tracks every
      major release from OpenAI's ChatGPT and Anthropic's Claude since 2022,
      plotted against MMLU — the benchmark most consistently reported across
      both labs over time. The headline story is convergence: Claude entered
      2023 roughly 13 points behind GPT-4 and had fully caught up by mid-2024.
      Both are now crowded near the 96–97% ceiling, which is why the industry
      has shifted to harder tests — SWE-bench, FrontierMath, and agentic
      evaluations — to tell them apart. Hover over any data point for model
      details and release context.
    </p>
    <div class="meta muted">
      <span>Last updated: 9 March 2026</span>
      <span class="sep">·</span>
      <span>Todd McCaffrey, Foxxe Labs</span>
    </div>
  </header>

  <section class="chart-section">
    <AITimeline client:load />
  </section>

  <footer class="page-footer card">
    <p>
      Related research: &nbsp;
      <a href="/ai-bubble/index.html">Managing the AI Bubble</a>
      &nbsp;·&nbsp;
      <a href="/after-the-bubble/index.html">After the Bubble: What Comes Next?</a>
    </p>
  </footer>

</BaseLayout>

<style>
  .page-header {
    margin-bottom: 18px;
  }

  .eyebrow {
    font-size: .8rem;
    text-transform: uppercase;
    letter-spacing: .18em;
    color: var(--accent);
    font-weight: 700;
    margin-bottom: 10px;
  }

  .lede {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 72ch;
    margin: 0 0 14px;
  }

  .meta {
    font-size: .85rem;
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
  }

  .sep { opacity: .4; }

  .chart-section {
    border-radius: 22px;
    overflow: hidden;
    margin-bottom: 18px;
    border: 1px solid var(--border);
  }

  .page-footer {
    font-size: .95rem;
  }

  .page-footer p {
    margin: 0;
    color: var(--muted);
  }
</style>
