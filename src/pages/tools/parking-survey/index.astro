---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="ATU Parking App — Research Survey · Foxxe Labs" description="Help us understand the parking problem at ATU Letterkenny. 2-minute survey with app wireframe.">
  <div class="tool-page">
    <header class="tool-header">
      <h1>ATU Parking — Would This App Help?</h1>
      <p class="sub">
        Parking at ATU Letterkenny is the #1 student complaint. We're researching whether a
        real-time availability app would actually fix it. Takes 2 minutes. Completely anonymous.
      </p>
      <div class="pillrow">
        <span class="pill">~2 minutes</span>
        <span class="pill">Anonymous</span>
        <span class="pill">ATU Letterkenny</span>
      </div>
    </header>

    <main class="survey-wrap">

      <!-- ── Concept intro ── -->
      <section class="card intro-card">
        <p class="muted">
          Imagine an app that showed you — <strong>before you left home</strong> — which ATU car parks
          are likely to have spaces right now. Based on reports from other students who parked there recently.
          Below are two screens from the concept. Take a look, then answer a few questions.
        </p>
      </section>

      <!-- ── Wireframe 1: Main screen ── -->
      <section class="card wireframe-card">
        <div class="wf-label">App concept — main screen</div>
        <p class="muted wf-desc">Live availability for each car park. Green = available. Amber = filling. Red = likely full.</p>
        <div class="wireframe" aria-label="App wireframe: main parking screen">
          <div class="phone-shell">
            <div class="phone-bar">
              <span class="phone-dot"></span><span class="phone-dot"></span><span class="phone-dot"></span>
            </div>
            <div class="phone-screen">
              <div class="app-header">
                <span class="app-logo">🅿 ParkATU</span>
                <span class="app-time">Now · Tue 9:05am</span>
              </div>
              <div class="app-subtitle muted-wf">Near ATU Letterkenny</div>
              <div class="park-list">
                <div class="park-item red">
                  <div class="park-dot red-dot"></div>
                  <div class="park-info">
                    <div class="park-name">Main Campus Car Park</div>
                    <div class="park-status">Likely full — 0–2 spaces</div>
                  </div>
                  <div class="park-dist">0.1km</div>
                </div>
                <div class="park-item amber">
                  <div class="park-dot amber-dot"></div>
                  <div class="park-info">
                    <div class="park-name">Port Road Overflow</div>
                    <div class="park-status">Filling up — ~8 spaces</div>
                  </div>
                  <div class="park-dist">0.3km</div>
                </div>
                <div class="park-item green">
                  <div class="park-dot green-dot"></div>
                  <div class="park-info">
                    <div class="park-name">Pearse Road Car Park</div>
                    <div class="park-status">Available — plenty of space</div>
                  </div>
                  <div class="park-dist">0.5km</div>
                </div>
              </div>
              <div class="app-footer muted-wf">Based on 14 reports in the last 30 min</div>
            </div>
          </div>
        </div>
      </section>

      <!-- ── Wireframe 2: Report screen ── -->
      <section class="card wireframe-card">
        <div class="wf-label">App concept — quick report</div>
        <p class="muted wf-desc">After you park, one tap tells the next person what to expect. Takes 3 seconds.</p>
        <div class="wireframe" aria-label="App wireframe: quick report screen">
          <div class="phone-shell">
            <div class="phone-bar">
              <span class="phone-dot"></span><span class="phone-dot"></span><span class="phone-dot"></span>
            </div>
            <div class="phone-screen">
              <div class="app-header">
                <span class="app-logo">🅿 ParkATU</span>
                <span class="app-chip">You're at Main Campus</span>
              </div>
              <div class="report-prompt">How was parking just now?</div>
              <div class="report-btns">
                <button type="button" class="report-btn green-btn">😌 Easy</button>
                <button type="button" class="report-btn amber-btn">😐 Tight</button>
                <button type="button" class="report-btn red-btn">😤 Nightmare</button>
              </div>
              <div class="app-footer muted-wf">Your report helps the next person. Takes 3 seconds.</div>
            </div>
          </div>
        </div>
      </section>

      <!-- ── CTA ── -->
      <section class="card cta-card">
        <h2>Seen enough? Tell us what you think.</h2>
        <p class="muted">
          8 quick questions — would you use it, would you report, and the one question
          that will decide how it gets built. Opens in Google Forms.
        </p>
        <a
          href="https://forms.gle/MrtfhgQA87L3RZGh6"
          target="_blank"
          rel="noopener noreferrer"
          class="survey-btn"
        >
          Take the 2-minute survey →
        </a>
        <p class="fine">Anonymous. No Google account required. Results used only for FoxxeLabs research.</p>
      </section>

    </main>
  </div>
</BaseLayout>

<style>
  .tool-header {
    padding: 28px 18px 10px;
    max-width: 720px;
    margin: 0 auto;
  }

  h1 {
    margin: 0 0 8px 0;
    font-size: clamp(1.4rem, 2.8vw, 2rem);
  }

  .sub {
    color: var(--muted);
    margin: 0;
    max-width: 65ch;
  }

  .pillrow {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 10px;
  }

  .pill {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 5px 10px;
    color: var(--muted);
    font-size: .85rem;
    background: rgba(255,255,255,.03);
  }

  .survey-wrap {
    max-width: 720px;
    margin: 0 auto;
    padding: 16px 18px 64px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .intro-card p {
    margin: 0;
    line-height: 1.7;
  }

  /* ── Wireframes ── */
  .wireframe-card { gap: 12px; }

  .wf-label {
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: rgba(167,139,250,.8);
  }

  .wf-desc { margin: 0; font-size: .9rem; }

  .wireframe {
    display: flex;
    justify-content: center;
  }

  .phone-shell {
    width: 260px;
    background: #0d1117;
    border: 2px solid rgba(255,255,255,.15);
    border-radius: 28px;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0,0,0,.5);
  }

  .phone-bar {
    display: flex;
    gap: 5px;
    padding: 10px 14px 6px;
    align-items: center;
    background: #0a0e14;
  }

  .phone-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: rgba(255,255,255,.2);
  }

  .phone-screen {
    padding: 12px 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: 220px;
  }

  .app-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .app-logo { font-weight: 800; font-size: .95rem; color: #7dd3fc; }

  .app-time { font-size: .72rem; color: rgba(255,255,255,.4); }

  .app-chip {
    font-size: .72rem;
    background: rgba(125,211,252,.1);
    border: 1px solid rgba(125,211,252,.2);
    border-radius: 999px;
    padding: 2px 8px;
    color: #7dd3fc;
  }

  .app-subtitle { font-size: .78rem; margin-bottom: 4px; }

  .muted-wf { color: rgba(255,255,255,.35); font-size: .75rem; }

  .park-list { display: flex; flex-direction: column; gap: 6px; }

  .park-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border-radius: 10px;
    border: 1px solid transparent;
  }

  .park-item.red   { background: rgba(239,68,68,.08);  border-color: rgba(239,68,68,.2); }
  .park-item.amber { background: rgba(251,191,36,.08); border-color: rgba(251,191,36,.2); }
  .park-item.green { background: rgba(52,211,153,.08); border-color: rgba(52,211,153,.2); }

  .park-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
  .red-dot   { background: #ef4444; }
  .amber-dot { background: #fbbf24; }
  .green-dot { background: #34d399; }

  .park-info { flex: 1; }
  .park-name  { font-size: .78rem; font-weight: 600; color: rgba(255,255,255,.85); }
  .park-status { font-size: .7rem; color: rgba(255,255,255,.4); margin-top: 1px; }
  .park-dist  { font-size: .7rem; color: rgba(255,255,255,.3); flex-shrink: 0; }

  .app-footer { margin-top: 4px; text-align: center; }

  .report-prompt {
    font-weight: 700; font-size: .95rem;
    text-align: center; margin: 12px 0 8px;
    color: rgba(255,255,255,.85);
  }

  .report-btns { display: flex; gap: 6px; justify-content: center; }

  .report-btn {
    border: none; border-radius: 10px;
    padding: 8px 10px; font-size: .8rem;
    cursor: default; font-weight: 600;
  }

  .green-btn { background: rgba(52,211,153,.2); color: #34d399; }
  .amber-btn { background: rgba(251,191,36,.2); color: #fbbf24; }
  .red-btn   { background: rgba(239,68,68,.2);  color: #ef4444; }

  /* ── CTA ── */
  .cta-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-start;
  }

  .cta-card h2 { margin: 0; font-size: 1.1rem; }
  .cta-card .muted { margin: 0; }

  .survey-btn {
    display: inline-block;
    padding: 13px 28px;
    background: linear-gradient(180deg, rgba(125,211,252,.25), rgba(167,139,250,.12));
    border: 1px solid rgba(125,211,252,.35);
    border-radius: 12px;
    color: var(--text);
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    transition: border-color .15s;
  }

  .survey-btn:hover {
    border-color: rgba(125,211,252,.65);
  }

  .fine {
    font-size: .82rem;
    color: var(--muted);
    margin: 0;
  }
</style>
