---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Add a project = add a line. group: tools | quizzes | experimental
// The cabinet itself lives in src/data/tools.js so the homepage Workshop card
// can read the same list instead of keeping its own copy of the headliners.
import { SECTIONS } from '../../data/tools.js';

const isExternal = (u: string) => u.startsWith('http');
---

<BaseLayout
  title="The Workshop · Foxxe Labs"
  description="Tools, quizzes, and experiments from Foxxe Labs — most run entirely in your browser."
>
  <div class="lab">
    <header class="lab-head">
      <h1>The Workshop</h1>
      <p class="muted lab-intro">Small, sharp things from Foxxe Labs. Most run entirely in your browser — no accounts, no servers watching. Feel free to explore.</p>
    </header>

    {SECTIONS.map(section => (
      <section class="lab-section">
        <div class="sec-head">
          <h2>{section.label}</h2>
          <span class="sec-count">{String(section.items.length).padStart(2, '0')}</span>
          <span class="sec-line"></span>
        </div>

        <div class="grid">
          {section.items.map(p => (
            <a
              class="card tool-card"
              href={p.url}
              target={isExternal(p.url) ? '_blank' : null}
              rel={isExternal(p.url) ? 'noopener' : null}
            >
              {p.exp && <span class="badge">Experimental</span>}
              <h3 class="t-name">{p.name}</h3>
              {p.gloss && <div class="t-gloss">{p.gloss}</div>}
              <p class="t-hook">{p.hook}</p>
              <div class="pills">
                {p.tags.map(tag => <span class="pill">{tag}</span>)}
              </div>
              {p.req && <p class="t-req"><b>Requires</b> {p.req}</p>}
              <span class="t-go">
                <span class="t-dom">{p.dom}</span>
                <span class="t-open">Open <span class="arr">→</span></span>
              </span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .lab { max-width: 980px; margin: 0 auto; }
  .lab-head { margin-bottom: 8px; }
  .lab-intro { max-width: 54ch; font-size: 1.02rem; }

  /* section headers */
  .lab-section { margin-top: 38px; }
  .lab-section:first-of-type { margin-top: 22px; }
  .sec-head { display: flex; align-items: baseline; gap: 14px; margin-bottom: 16px; }
  .sec-head h2 { margin: 0; font-size: 1.15rem; white-space: nowrap; }
  .sec-count { font-family: var(--font-mono); font-size: .62rem; letter-spacing: .14em; color: var(--muted); }
  .sec-line { flex: 1; height: 1px; background: var(--border); }

  /* grid */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 16px;
  }

  /* card (uses the global .card base, adds layout + interaction) */
  .tool-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 20px;
    text-decoration: none;
    color: var(--text);
    border-radius: 18px;
    overflow: hidden;
    transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
  }
  .tool-card::after {
    content: '';
    position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
    background: var(--accent);
    transform: scaleY(0); transform-origin: top;
    transition: transform .3s cubic-bezier(.2,.7,.2,1);
  }
  .tool-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
  }
  .tool-card:hover::after { transform: scaleY(1); }

  .badge {
    position: absolute; top: 16px; right: 16px;
    font-family: var(--font-mono); font-size: .54rem; letter-spacing: .12em; text-transform: uppercase;
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 50%, var(--border));
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border-radius: 999px; padding: 3px 8px;
  }

  .t-name { margin: 0; font-size: 1.3rem; letter-spacing: -.01em; }
  .t-gloss { color: var(--accent); font-style: italic; font-size: .9rem; margin: 3px 0 10px; }
  .t-hook { margin: 0; flex: 1; color: var(--text); font-size: .96rem; line-height: 1.5; }

  .pills { display: flex; flex-wrap: wrap; gap: 6px; margin: 14px 0 0; }
  .pill {
    font-family: var(--font-mono); font-size: .6rem; letter-spacing: .04em;
    color: var(--muted); border: 1px solid var(--border);
    border-radius: 999px; padding: 3px 8px;
  }

  .t-req {
    font-size: .8rem; color: var(--muted); line-height: 1.45;
    margin: 12px 0 0; padding-left: 10px;
    border-left: 2px solid color-mix(in srgb, var(--accent) 40%, var(--border));
  }
  .t-req b {
    display: block; font-family: var(--font-mono); font-weight: 600;
    font-size: .56rem; letter-spacing: .13em; text-transform: uppercase;
    color: var(--accent); margin-bottom: 3px;
  }

  .t-go {
    display: flex; align-items: baseline; justify-content: space-between; gap: 14px;
    margin-top: 16px; padding-top: 14px;
    border-top: 1px solid var(--border);
  }
  .t-dom { font-family: var(--font-mono); font-size: .72rem; color: var(--muted); }
  .t-open { font-family: var(--font-mono); font-size: .7rem; text-transform: uppercase; letter-spacing: .14em; color: var(--accent); white-space: nowrap; }
  .t-open .arr { display: inline-block; transition: transform .25s ease; }
  .tool-card:hover .arr { transform: translateX(4px); }
  .tool-card:hover .t-dom { color: var(--text); }

  @media (prefers-reduced-motion: reduce) {
    .tool-card, .arr { transition: none; }
  }
</style>
