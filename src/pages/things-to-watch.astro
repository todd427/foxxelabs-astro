---
// src/pages/things-to-watch.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import LLMSpotlight from '../components/LLMSpotlight.astro';
import spotlight from '../../data/spotlight.json';

const hasPick = !!spotlight?.pick;
const also = spotlight?.also ?? [];
const updated = spotlight?.updatedAt ? spotlight.updatedAt.split('T')[0] : null;

const fmt = (n: number) =>
  n >= 1_000_000 ? `${(n / 1e6).toFixed(1)}M`
  : n >= 1_000   ? `${(n / 1e3).toFixed(1)}K`
  : `${n}`;
const age = (d: number | null) =>
  d == null ? '' : d < 1 ? 'new today' : `${d}d`;
---

<BaseLayout
  title="Things to Watch | Foxxe Labs"
  description="One open-weight model worth a real look, plus the rest of what's moving on Hugging Face right now — picked from the feed, not a leaderboard. Signal, not noise."
>
  <header class="page-header card">
    <div class="eyebrow">Foxxe Labs &middot; Signal, not noise</div>
    <h1>Things to Watch</h1>
    <p class="sub">One open-weight model worth a real look &mdash; plus the rest of what's moving on Hugging Face right now.</p>
    <p class="lede">The model release cycle is a firehose, and the old compass &mdash; Hugging Face's Open LLM Leaderboard &mdash; retired in 2025. This is the opposite of a leaderboard: one opinionated pick, with a handful of other live candidates below it and the hype-and-remix noise filtered out. It's deliberately not a ranking. For the hard numbers &mdash; benchmarks, pricing, context windows &mdash; the link goes out to llm-stats.</p>
  </header>

  <section class="watch">
    {hasPick ? (
      <LLMSpotlight />
    ) : (
      <div class="card empty">
        <p class="muted">The next pick is being selected &mdash; the daily run surfaces one shortly. Check back soon.</p>
      </div>
    )}
  </section>

  {also.length > 0 && (
    <section class="also card">
      <h2 class="also-h">Also moving on Hugging Face</h2>
      <ul class="also-list">
        {also.map((m) => (
          <li class="also-row">
            <a class="also-model" href={m.url} target="_blank" rel="noopener">
              <span class="also-author">{m.author}/</span>{m.name}
            </a>
            <span class="also-meta">&#9829; {fmt(m.likes)}{m.ageDays != null ? ` · ${age(m.ageDays)}` : ''}</span>
          </li>
        ))}
      </ul>
      <p class="also-note muted">Straight from the trending/new feed, noise filtered. Not curated, not a ranking.</p>
    </section>
  )}

  {updated && <p class="updated muted">Last reconciled {updated}.</p>}

  <footer class="page-footer card">
    <p>
      Related: &nbsp;<a href="/news/">News</a>
      &nbsp;&middot;&nbsp; <a href="/ai-timeline/">AI Model Performance Timeline</a>
      &nbsp;&middot;&nbsp; elsewhere: <a href="https://llm-stats.com" target="_blank" rel="noopener">llm-stats</a>,
      <a href="https://lmarena.ai" target="_blank" rel="noopener">LMArena</a>
    </p>
  </footer>
</BaseLayout>

<style>
  .page-header { margin-bottom: 18px; }
  .eyebrow {
    font-size: .8rem; text-transform: uppercase; letter-spacing: .18em;
    color: var(--accent); font-weight: 700; margin-bottom: 10px;
  }
  .page-header h1 { font-size: clamp(2.2rem, 5.5vw, 3.2rem); line-height: 1; margin: 0 0 8px; letter-spacing: -.01em; }
  .sub { color: var(--text); font-size: 1.1rem; font-style: italic; margin: 0 0 16px; }
  .lede { color: var(--muted); font-size: 1rem; line-height: 1.7; max-width: 72ch; margin: 0; }

  .watch { margin: 0 0 18px; }
  .empty { padding: 22px; }
  .empty p { margin: 0; }

  .also { margin: 0 0 18px; }
  .also-h { font-size: .82rem; text-transform: uppercase; letter-spacing: .14em; color: var(--muted); font-weight: 700; margin: 0 0 12px; }
  .also-list { list-style: none; margin: 0; padding: 0; }
  .also-row {
    display: flex; align-items: baseline; justify-content: space-between; gap: 1rem;
    padding: 9px 0; border-bottom: 1px solid var(--border);
  }
  .also-row:last-child { border-bottom: 0; }
  .also-model { text-decoration: none; font-size: 1rem; }
  .also-model:hover { text-decoration: underline; }
  .also-author { color: var(--muted); }
  .also-meta { color: var(--muted); font-size: .82rem; white-space: nowrap; }
  .also-note { font-size: .8rem; margin: 12px 0 0; }

  .updated { font-size: .82rem; margin: 0 2px 18px; }

  .page-footer { font-size: .95rem; }
  .page-footer p { margin: 0; color: var(--muted); }
</style>
